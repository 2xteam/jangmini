# jangmini 환경 변수
#
# 값은 .env.local 에 넣는다. .env.local 은 .gitignore 에 있다.
# 여기에는 절대 실제 값을 적지 않는다.

# --- 필수 ---

# MongoDB Atlas. Cluster0 의 jangmini DB 를 쓴다.
# 반드시 mongodb+srv:// 형식으로 — 표준 URI(mongodb:// + 샤드 3개)는
# Atlas 가 클러스터를 이전하면 호스트명이 바뀌어 조용히 끊긴다.
MONGO_URI=

# reader 로그인 쿠키(jangmini_reader) HMAC 서명용. 충분히 긴 랜덤 문자열.
# myjane 의 SESSION_SECRET 과 같은 값을 쓰지 않는다 — 별개 인증 체계다.
SESSION_SECRET=

# reader_history 의 ipHash 계산용 salt. 원문 IP 는 저장하지 않는다.
IP_HASH_SALT=

# --- AI (Phase 5) ---

# jangmini 전용 OpenAI 프로젝트의 키를 쓴다. 다른 앱과 공유하지 않는다.
# 해당 프로젝트에 monthly hard limit 을 걸어 두는 것이 최종 방어선이다.
OPENAI_API_KEY=

# --- 여기에 두지 않는 것 ---
#
# MONGO_DB           : DB 이름은 lib/db.ts 에서 "jangmini" 로 못 박는다.
#                      환경 변수로 두면 다른 앱 값이 복사돼 들어와, 데이터가
#                      조용히 남의 DB 로 들어간다 (myjane 볼트에 사고 2건 기록)
# NEXT_PUBLIC_COOKIE_DOMAIN
#                    : 넣으면 reader 쿠키가 .myjane.co.kr 로 퍼져 여섯 앱에
#                      전송된다. jangmini 쿠키는 호스트 전용이다
# 한도·모델·킬스위치  : settings 컬렉션에 둔다. 환경 변수는 배포 시점에
#                      스냅샷되므로 숫자 하나 바꿀 때마다 재배포해야 한다
# GITHUB_TOKEN       : 원본이 /api/github-stars 에서 toukoum/portfolio 의 star
#                      수를 읽는 데만 썼다. 원작자 저장소 홍보라 Phase 2 에서
#                      라우트째 지운다. 이 앱에 필요 없다
# OPENAI_VISION_MODEL: 이 앱에는 이미지 입력 기능이 없다. SnapNote·FitLog 의
#                      .env.local 을 복사하면 따라오지만 쓰이지 않는다
